#: src/global.c:618
msgid "Go back one word"
msgstr "Przejdź o słowo wstecz"

#: src/global.c:619
msgid "Go forward one word"
msgstr "Przejdź o słowo do przodu"

#: src/global.c:620
msgid "Go to previous line"
