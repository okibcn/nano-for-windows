msgstr "Użyj tylko tego pliku do konfigurowania nano"

#: src/nano.c:588
msgid "Show cursor in file browser & help text"
msgstr "Pokaż kursor w przeglądarce plików i tekście pomocy"

#: src/nano.c:590
