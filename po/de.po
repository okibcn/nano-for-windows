msgstr "Absicht eine Tabulatorbreite nach links rollen"

#: src/global.c:644
msgid "Scroll the viewport a tabsize to the right"
msgstr "Absicht eine Tabulatorbreite nach rechts rollen"

#: src/global.c:648
msgid "Scroll up one line without moving the cursor textually"
msgstr "Eine Zeile hochrollen, ohne den Cursor im Text zu bewegen"

#: src/global.c:650
msgid "Scroll down one line without moving the cursor textually"
msgstr "Eine Zeile hinunterrollen, ohne den Cursor im Text zu bewegen"

