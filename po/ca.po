#: src/global.c:616
msgid "Go back one character"
msgstr "Vés enrere un caràcter"

#: src/global.c:617
msgid "Go forward one character"
msgstr "Vés endavant un caràcter"

#: src/global.c:618
msgid "Go back one word"
