#: src/global.c:644
msgid "Scroll the viewport a tabsize to the right"
msgstr "Desplaça l'àrea de visualització un tabulador a la dreta"

#: src/global.c:648
msgid "Scroll up one line without moving the cursor textually"
msgstr "Desplaça amunt una línia sense moure el cursor pel text"

#: src/global.c:650
msgid "Scroll down one line without moving the cursor textually"
msgstr "Desplaça avall una línia sense moure el cursor pel text"

#: src/global.c:653
msgid "Switch to the previous file buffer"
msgstr "Canvia a l'anterior búfer de fitxer"

#: src/global.c:654
msgid "Switch to the next file buffer"
msgstr "Canvia al següent búfer de fitxer"

# Verbatim -> textualment segons un diccionari online.
# S'accepten altres propostes. jm
#: src/global.c:656
msgid "Insert the next keystroke verbatim"
msgstr "Insereix la següent premuda de tecla textualment"

#: src/global.c:657
msgid "Insert a tab at the cursor position (or indent marked lines)"
