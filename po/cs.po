#: src/nano.c:622
msgid "Save changes on exit, don't prompt"
msgstr "Uložit při ukončení, nedotazovat se"

#: src/nano.c:624
msgid "Save a file by default in Unix format"
msgstr "Ve výchozím nastavení soubor uložit ve formátu Unix"

#: src/nano.c:626
