#: src/nano.c:642
msgid "Show some states on the title bar"
msgstr "Ukázat některé stavy v titulkovém pruhu"

#: src/nano.c:643
msgid "Show a feedback bar at the bottom"
msgstr "Ukázat panel zpětné vazby ve spodní části"

#: src/nano.c:644
