msgstr "První bílý znak znamená nový odstavec"

#: src/nano.c:545
msgid "Save & restore position of the cursor"
msgstr "Uložit a obnovit polohu ukazatele"

#: src/nano.c:548
msgid "-Q <regex>"
msgstr "-Q <reg.výraz>"

#: src/nano.c:548
