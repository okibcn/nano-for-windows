msgstr "Žádný název souboru"

#: src/nano.c:314
msgid "Save modified buffer? "
msgstr "Uložit změněnou vyrovnávací paměť? "

#: src/nano.c:339
#, c-format
msgid ""
"\n"
"Too many .save files\n"
