msgstr "Zachovat klávesy XON (^Q) a XOFF (^S)"

#: src/nano.c:611
msgid "Show a position+portion indicator"
msgstr "Zobrazit indikátor pozice+části"

#: src/nano.c:614
msgid "-r <number>"
msgstr "-r <číslo>"

#: src/nano.c:614
msgid "--fill=<number>"
